{"nodes": [{"id": "tap_to_pay_on_iphone_index", "label": "Tap to Pay on iPhone", "file_type": "document", "source_file": "tap-to-pay-on-iphone/index.md", "source_location": "L1", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/tap-to-pay-on-iphone", "captured_at": null, "author": null, "contributor": null}, {"id": "tap_to_pay_on_iphone_index_contactless_payments", "label": "Contactless Payment Acceptance", "file_type": "concept", "source_file": "tap-to-pay-on-iphone/index.md", "source_location": "L10", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/tap-to-pay-on-iphone", "captured_at": null, "author": null, "contributor": null, "rationale": "Enables merchants to accept contactless credit/debit cards and Apple Pay directly on iPhone using NFC and ProximityReader without additional hardware."}, {"id": "tap_to_pay_on_iphone_index_admin_enablement", "label": "Administrative Enablement & Education", "file_type": "rationale", "source_file": "tap-to-pay-on-iphone/index.md", "source_location": "L38", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/tap-to-pay-on-iphone", "captured_at": null, "author": null, "contributor": null, "rationale": "Present terms and conditions only to administrative users prior to checkout, offering localized interactive merchant tutorials."}, {"id": "tap_to_pay_on_iphone_index_background_preparation", "label": "Card Reader Background Preparation", "file_type": "rationale", "source_file": "tap-to-pay-on-iphone/index.md", "source_location": "L82", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/tap-to-pay-on-iphone", "captured_at": null, "author": null, "contributor": null, "rationale": "Prepare reader APIs immediately on app launch and foreground transitions; show determinate/indeterminate progress indicators during configuration."}, {"id": "tap_to_pay_on_iphone_index_button_branding", "label": "Tap to Pay Button Branding Rules", "file_type": "concept", "source_file": "tap-to-pay-on-iphone/index.md", "source_location": "L98", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/tap-to-pay-on-iphone", "captured_at": null, "author": null, "contributor": null, "rationale": "Label button 'Tap to Pay on iPhone' or 'Tap to Pay' with wave SF Symbol; never include the Apple logo on the button."}, {"id": "tap_to_pay_on_iphone_index_authorization_and_receipts", "label": "Transaction Authorization & Digital Receipts", "file_type": "concept", "source_file": "tap-to-pay-on-iphone/index.md", "source_location": "L124", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/tap-to-pay-on-iphone", "captured_at": null, "author": null, "contributor": null, "rationale": "Display authorization progress indicator before clear decline/approval screens, providing immediate digital receipt options (QR/SMS)."}, {"id": "tap_to_pay_on_iphone_index_nonpayment_modes", "label": "Nonpayment Card Reading & Loyalty", "file_type": "concept", "source_file": "tap-to-pay-on-iphone/index.md", "source_location": "L158", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/tap-to-pay-on-iphone", "captured_at": null, "author": null, "contributor": null, "rationale": "Use neutral labels ('Store Card', 'Verify', 'Refund') when reading cards without transaction amounts; isolate loyalty card transactions."}, {"id": "tap_to_pay_on_iphone_index_proximityreader", "label": "ProximityReader Framework", "file_type": "code", "source_file": "tap-to-pay-on-iphone/index.md", "source_location": "L191", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/tap-to-pay-on-iphone", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "tap_to_pay_on_iphone_index", "target": "tap_to_pay_on_iphone_index_contactless_payments", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tap-to-