{"nodes": [{"id": "immersive_experiences_index_immersive_experiences", "label": "Immersive Experiences", "file_type": "document", "source_file": "immersive-experiences/index.md", "source_location": "L1", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/immersive-experiences", "captured_at": null, "author": null, "contributor": null}, {"id": "immersive_experiences_index_space_contexts", "label": "visionOS Shared Space vs Full Space", "file_type": "concept", "source_file": "immersive-experiences/index.md", "source_location": "L18", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/immersive-experiences", "captured_at": null, "author": null, "contributor": null, "rationale": "Apps launch alongside others in Shared Space or transition into Full Space where sole focus and unbounded 3D experiences occur."}, {"id": "immersive_experiences_index_immersion_styles", "label": "visionOS Immersion Styles (Mixed, Progressive, Full)", "file_type": "concept", "source_file": "immersive-experiences/index.md", "source_location": "L35", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/immersive-experiences", "captured_at": null, "author": null, "contributor": null, "rationale": "Mixed immersion blends 3D objects with passthrough; progressive replaces part of passthrough adjustable via Digital Crown; full creates a 360-degree environment."}, {"id": "immersive_experiences_index_passthrough_safety_boundary", "label": "Passthrough and Safety Boundary Management", "file_type": "rationale", "source_file": "immersive-experiences/index.md", "source_location": "L26", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/immersive-experiences", "captured_at": null, "author": null, "contributor": null, "rationale": "A 1.5-meter head movement boundary and automatic opacity adjustments protect users from physical collisions while in immersion."}, {"id": "immersive_experiences_index_virtual_hands", "label": "Virtual Hands Representation", "file_type": "concept", "source_file": "immersive-experiences/index.md", "source_location": "L67", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/immersive-experiences", "captured_at": null, "author": null, "contributor": null, "rationale": "Render virtual hands at true-to-life scale matching user gestures; fade out cleanly to real hands if hand tracking is interrupted."}, {"id": "immersive_experiences_index_custom_environments", "label": "visionOS Custom Environments and Ground Plane", "file_type": "concept", "source_file": "immersive-experiences/index.md", "source_location": "L78", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/immersive-experiences", "captured_at": null, "author": null, "contributor": null, "rationale": "Include ground plane meshes and lighting shaders to prevent disorientation and claustrophobia; avoid flat 360-degree static image spheres."}], "edges": [{"source": "immersive_experiences_index_space_contexts", "target": "immersive_experiences_index_immersive_experiences", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "immersive-experiences/index.md", "source_location": "L18", "weight": 1.0}, {"source": "immersive_experiences_index_immersion_styles", "target": "immersive_experiences_index_immersive_experiences", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "immersive-experiences/index.md", "source_location": "L35", "weight": 1.0}, {"source": "immersive_experiences_index_passthrough_safety_boundary", "target": "immersive_experiences_index_immersive_experiences", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "immersive-experiences/index.md", "source_location": "L26", "weight": 1.0}, {"source": "immersive_experiences_index_virtual_hands", "target": "immersive_experiences_index_imm