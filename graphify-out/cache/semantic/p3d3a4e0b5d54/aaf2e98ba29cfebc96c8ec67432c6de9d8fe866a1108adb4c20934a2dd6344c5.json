{"nodes": [{"id": "accessibility_index_accessibility", "label": "Accessibility", "file_type": "document", "source_file": "accessibility/index.md", "source_location": "L1", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/accessibility", "captured_at": null, "author": null, "contributor": null, "rationale": "Accessible interfaces empower everyone to interact with apps regardless of ability by adhering to intuitive, perceivable, and adaptable design principles."}, {"id": "accessibility_index_vision", "label": "Vision Accessibility", "file_type": "concept", "source_file": "accessibility/index.md", "source_location": "L24", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/accessibility", "captured_at": null, "author": null, "contributor": null, "rationale": "Support Dynamic Type scaling by at least 200%, meet WCAG AA contrast minimums (4.5:1 text, 3:1 bold/large), prefer system colors, and never convey info with color alone."}, {"id": "accessibility_index_hearing", "label": "Hearing Accessibility", "file_type": "concept", "source_file": "accessibility/index.md", "source_location": "L100", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/accessibility", "captured_at": null, "author": null, "contributor": null, "rationale": "Ensure all audio content provides closed captions, visual indicators, or subtitles so deaf and hard-of-hearing users can access dialogue and non-speech sound effects."}, {"id": "accessibility_index_mobility", "label": "Mobility and Motor Accessibility", "file_type": "concept", "source_file": "accessibility/index.md", "source_location": "L110", "source_url": "https://developer.apple.com/design/Human-Interface-Guidelines/accessibility", "captured_at": null, "author": null, "contributor": null, "rationale": "Provide minimum target sizes (44x44 pt on iOS/watchOS, 60x60 pt on visionOS), simple gestures, and alternative onscreen controls for physical interactions."}, {"id": 